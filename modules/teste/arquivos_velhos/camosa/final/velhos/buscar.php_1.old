<?php

require "conexao.php";

$sel="SELECT id_documentador,numerodocumento,id_departamentos,vocativo,mensagem,desfecho,id_assinaturas  
      FROM documentador  
      WHERE id_tipo='$id_tipo' 
      ORDER BY id_documentador DESC";

$resultado=pg_query($sel) or die ("Não foi possível realizar a consulta ao banco de dados");

$contador=pg_num_rows($resultado);

if ($contador == 0)
	echo " <p> Não existe nenhum documento.</p>";
else {
		while ($linha=pg_fetch_array($resultado))
			{
			$id_documentador=trim($linha["id_documentador"]);
			$id_tipo=trim($linha["id_tipo"]);
			$numerodocumento=trim($linha["numerodocumento"]);
			$id_departamentos=trim($linha["id_departamentos"]);
			$vocativo=trim($linha["vocativo"]);
			$mensagem=trim($linha["mensagem"]);
			$desfecho=trim($linha["desfecho"]);
			$id_assinaturas=trim($linha["id_assinaturas"]);
				 
	
			echo "<a href='edicao.php?id_documentador=$id_documentador'> <p>- Destino:<b>$id_departamentos</b><br> - Número do documento:<b>$numerodocumento</b><br>- Mensagem: <b>$mensagem</b><br>- Assinatura: <b>$id_assinaturas</b></a></p></font><br><br>";
		}
	}
