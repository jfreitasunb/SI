<?php
require "verifica.php";


$dado=$_POST["dado"]; //variável que contém as informações do documento
$acao=$_POST["acao"]; //variável que contém a ação de visualizar ou de salvar no rascunho


//tratamento para verificação de preenchimento dos campos, a exceção do campo 'anexo' para memorando e ofício
//setagem da chave 'valor' para validação de postagem no banco
if(!isset($_POST["segunda"])){
	$valor="";
	$tratamento="no";
	if(($dado[0]=="1") || ($dado[0]=="3"))
                if(!$dado[3]){
                        $dado[3]="preencheu";
			$tratamento="ok";
			}

	foreach($dado as $preenchido){
		if(!$preenchido){
			echo "
			<head>
			<meta http-equiv='content-type' content='text/html; charset=iso-8859-1'>
			<title>Servidor Administrativo</title><style type='text/css' media='all'>@import 'style.css';</style></head>
			<body>
			<div id='Header'></div>
			<div id='Content'>
        			<h1>Atenção!</h1>
				<p> É necessário preencher todos os campos em (*). Clique no <i>link</i> abaixo para retornar. </p>
				<p><a href='javascript:history.back(-1);'> Retornar</a></p><br>";
			require "menu.php";
			echo "</body></html> ";
			exit;
			}
		else if (strlen($preenchido) > strlen($valor)) 
			$valor=$preenchido;
		}
	if($tratamento=="ok")
		$dado[3]="";

	}

//seleção da ação a partir do valor 'ação'
require "conexao.php";
$data=strftime("%d/%m/%Y");	 
if ($acao == "Salvar Rascunho"){
	//verificação se o documento já foi inserido anteriormente na mesma seção
	if((!isset($_SESSION["verifica_reenvio"])) || strcmp($_SESSION["verifica_reenvio"],$valor)){
		$_SESSION["verifica_reenvio"]=$valor;
		if(($dado[0]=="1"))	
			$resultado1=pg_query("INSERT INTO rascunho (id_documentador,id_tipo,id_departamentos,vocativo,
			mensagem,desfecho,id_assinaturas,assunto,anexo,data) VALUES (default,'$dado[0]','$dado[1]',
			'$dado[4]','$dado[5]','$dado[6]','$dado[7]','$dado[2]','$dado[3]','$data')")
			or die ("Não foi possível inserir os dados no banco");

		if(($dado[0]=="3"))                    
                        $resultado1=pg_query("INSERT INTO rascunho (id_documentador,id_tipo,desfecho,assunto,anexo,
                        vocativo,mensagem,id_assinaturas,data) VALUES (default,'$dado[0]','$dado[1]','$dado[2]',
                        '$dado[3]','$dado[4]','$dado[5]','$dado[6]','$data')") 
                        or die ("Não foi possível inserir os dados no banco");


		else if ($dado[0]=="2")	
			$resultado1=pg_query("INSERT INTO rascunho (id_documentador,id_tipo,id_assinaturas,anexo,
                        assunto,vocativo,mensagem,desfecho,data) VALUES (default,'$dado[0]','$dado[1]','$dado[2]',
                        '$dado[3]','$dado[4]','$dado[5]','$dado[6]','$data')")
                        or die ("Não foi possível inserir os dados no banco");

		else if ($dado[0]=="4")	
			$resultado1=pg_query("INSERT INTO rascunho (id_documentador,id_tipo,mensagem,
                        id_assinaturas,data) VALUES (default,'$dado[0]','$dado[1]','$dado[2]',
                        '$data')")
                        or die ("Não foi possível inserir os dados no banco");

		else if ($dado[0]=="5")	
			$resultado1=pg_query("INSERT INTO rascunho (id_documentador,id_tipo,mensagem,
                        data) VALUES (default,'$dado[0]','$dado[1]',
                        '$data')")
                        or die ("Não foi possível inserir os dados no banco");


		echo "
			<head> 
                	<meta http-equiv='content-type' content='text/html; charset=iso-8859-1'>
                	<title>Servidor Administrativo</title><style type='text/css' media='all'>@import 'style.css';</style>
                	</head>
                	<body> 
                	<div id='Header'></div>
                	<div id='Content'>
                	<h1>Servidor Administrativo</h1>
				<p> O documento foi inserido como <i>rascunho</i>. Para que ele possa ser impresso, clique no botão
				abaixo.</p><br>
			
			<form method='post' action='ati.php'>
			<div align='center'>";
			foreach($dado as $valor){
				echo"
    				<input name='dado[]' type='hidden' value='$valor'>";
				}
			echo"
    				<input type='hidden' name='segunda' value='ok'>
				<input type='submit' name='acao' value='Visualizar'>
			</div></form>";
			require "menu.php";
			echo"</body></html> ";
		} 
	else 
		{
		echo"
		<head> 
		<meta http-equiv='content-type' content='text/html; charset=iso-8859-1'>
		<title>Servidor Administrativo</title><style type='text/css' media='all'>@import 'style.css';</style></head>
		<body> 
		<div id='Header'></div> 
		<div id='Content'> 
        	<h1>Servidor Administrativo</h1>
        	<p> <b><i>O documento já foi salvo.</i></b> </p><br>";
		require "menu.php";
		echo"</body></html>";
		}
	}

//visualização do documento em pdf
else if ($acao=="Visualizar"){


	exec('/bin/rm -f /tmp/oliveira/ABAB*');
	require "acessorio.php";
	
	$seds[LATEXNUMERO]="XX";
	$seds[LATEXDATA]=$data; 
	
	if (($dado[0]=="1") ) //memorando
        	{
        	$seds[LATEXDESTINO]=$palavra_destino[0];
        	$seds[LATEXASSUNTO]=$dado[2];
        	$seds[LATEXANEXO]=$dado[3];
        	$seds[LATEXVOCATIVO]=$dado[4];
        	$seds[LATEXMENSAGEM]=$dado[5];
        	$seds[LATEXDESFECHO]=$dado[6];
        	$seds[LATEXNASSINATURA]=$palavra_assinatura[0];
        	$seds[LATEXCASSINATURA]=$palavra_assinatura[1];
        	$arquivo="modelo_memorando.tex";
        	}
	else if (($dado[0]=="3") ) //oficio
        	{
        	$seds[LATEXDESTINO]=$dado[1];
        	$seds[LATEXASSUNTO]=$dado[2];
        	$seds[LATEXANEXO]=$dado[3];
        	$seds[LATEXVOCATIVO]=$dado[4];
        	$seds[LATEXMENSAGEM]=$dado[5];
        	$seds[LATEXNASSINATURA]=$palavra_assinatura[0];
        	$seds[LATEXCASSINATURA]=$palavra_assinatura[1];
        	$arquivo="modelo_oficio.tex";
        	}
        else if($dado[0]=="2") //circular
        	{
        	$seds[LATEXDESTINO]=$dado[1];
		$seds[LATEXASSUNTO]=$dado[2];
		$seds[LATEXANEXO]=$dado[3];
        	$seds[LATEXVOCATIVO]=$dado[4];
        	$seds[LATEXMENSAGEM]=$dado[5];
        	$seds[LATEXNASSINATURA]=$palavra_assinatura[0];
		$seds[LATEXCASSINATURA]=$palavra_assinatura[1];
        	$arquivo="modelo_circular.tex";
        	}
	else if($dado[0]=="4") //ato
        	{
		$seds[LATEXMENSAGEM]=$dado[1];
        	$seds[LATEXNASSINATURA]=$palavra_assinatura[0];
		$seds[LATEXCASSINATURA]=$palavra_assinatura[1];
        	$arquivo="modelo_ato.tex";
        	}
        else if ($dado[0]=="5") //ata
        	{
        	$seds[LATEXMENSAGEM]=$dado[1];
        	$arquivo="modelo_ata.tex";
        	}

	foreach ($seds as $colchete => $valor){
		if ($colchete=="LATEXMENSAGEM")
			$seds[$colchete]=str_replace("\n",'pularlinha',$seds[$colchete]);
		else
			$seds[$colchete]=str_replace("\n",'',$seds[$colchete]);
		$seds[$colchete]=htmlentities($seds[$colchete]);
		$seds[$colchete]=str_replace("/",'barranormal',$seds[$colchete]);
		$seds[$colchete]=str_replace("&",'\&',$seds[$colchete]);
		$seds[$colchete]=str_replace("$",'simbolocifao',$seds[$colchete]);
		$seds[$colchete]=str_replace("%",'simboloporcentagem',$seds[$colchete]);
		$seds[$colchete]=str_replace("-",'simbolotraco',$seds[$colchete]);
		}


	$tmpfname = tempnam("/tmp/oliveira", "ABAB");
	exec("cat /usr/local/miolo/html/camosa/modelo_tex/".$arquivo." > ".$tmpfname.".tex");

	Header("Content-type: application/pdf");

	foreach($seds as $key => $val )
		{
exec('sed \'s/'.$key.'./'.$val.'/\' '.$tmpfname.'.tex > '.$tmpfname.'.tex.tmp; mv '.$tmpfname.'.tex.tmp  '.$tmpfname.'.tex');
		}

exec('cd /tmp/oliveira/ ; ./conversor2 '.$tmpfname.'.tex > '.$tmpfname.'.tex.mod ; mv '.$tmpfname.'.tex.mod '.$tmpfname.'.tex;
	/usr/local/bin/pdflatex -interaction nonstopmode '.$tmpfname.'.tex');

	$fp=fopen("".$tmpfname.".pdf","r");
 	while (!feof($fp)) {
   		$buffer = fgets($fp, 4096);
 		echo $buffer;
 		}
	fclose($fp);
	exec('/bin/rm -f '.$tmpfname.'*');

}

?>
