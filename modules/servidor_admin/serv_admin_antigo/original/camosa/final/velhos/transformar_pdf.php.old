function PDFClientes(){

$pdf = new PDF('L'); // relatoio em orientacao "paisagem"
$pdf->SetName("Listagem de Clientes");
$pdf->Open();
$pdf->AddPage();
$pdf->SetFont('Arial', '', 10);

$aDBLink = @mysql_connect( "192.168.0.28" , "tibola" , "l34ndr0my" );
if ( !empty($aDBLink) ) {
	if ( mysql_select_db( "tibola" , $aDBLink ) == True ) {
		$aSQL = "select * from tbcliente";
		$aQResult = mysql_query( $aSQL, $aDBLink );
		if ( $aQResult == True ) {

			while ( $row = mysql_fetch_array ( $aQResult ) ) {
				// Cell( w , h , string txt , border , ln , align , fill , link)
				$pdf->Cell(6, 5, $row[0], 0, 0); 	// codigocliente
				$pdf->Cell(50, 5, $row[1], 0, 0);	// nomecliente
				$pdf->Cell(50, 5, $row[2], 0, 0);	// enderecocliente
				$pdf->Cell(35, 5, $row[3], 0, 0);	// cidadecliente
				$pdf->Cell(25, 5, $row[4], 0, 0);	// fonecliente
				$pdf->Cell(35, 5, $row[5], 0, 0);	// emailcliente
				$pdf->Cell(2, 5, $row[6], 0, 1);	// sexocliente
				$total = $total + 1;
				}
			$pdf->Cell(20,5, "Total: ".$total, 1, 1);
			}
		else {
			print("Erro na consulta SQL !!");
			}
		}
	else {
		print("Erro na sele�o da tabela !!");
	}
}
else
{
print("Erro ao abrir banco de dados $Base ");
}

/* string Output([string name [, string dest]]) */


/* Se nenhum parametro for especificado, o destino será I  (browser) com o nome
doc.pdf . */
$pdf->Output();

/* I: envia o arquivo diretamente para o browser. Se o plug-in estiver
instalado ele será usado. O nome indicado por name é usado quando se usa
a opço "Salvar destino como" no link que gera o PDF. */

// $pdf->Output("teste_I.pdf","I");


/* D: envia para o browser e força o download do arquivo com o nome
indicado por name. */

// $pdf->Output("teste_D.pdf","D");

/* F: salva em um arquivo local com o nome informado em name. */
// $pdf->Output("teste_F.pdf","F");

/* S: retorna o documento como uma string. o name é ignorado. */
//$pdf->Output("teste_S.pdf","S");

/* para manter a compatibilidade com a versão anterior, um valor lógico também é
aceito (false para F e true para D) */

// grava teste.pdf no servidor
