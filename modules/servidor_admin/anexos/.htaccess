# Pasta de uploads: nunca executar nem servir scripts aqui (defesa em profundidade).
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php|phtml|php[0-9]|phps|phar|cgi|pl|py|asp|aspx|jsp|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
