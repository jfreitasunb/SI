# Anexos de documentos: NUNCA servidos diretamente pela web.
# O acesso passa por ../baixa_anexo.php, que exige login no modulo.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
