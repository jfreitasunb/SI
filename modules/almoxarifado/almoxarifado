
CREATE TABLE categorias (
    cod_cat integer NOT NULL,
    nome_cat character varying(30)
);

CREATE SEQUENCE categorias_cod_cat_seq
    INCREMENT BY 1
    NO MAXVALUE
    NO MINVALUE
    CACHE 1;


ALTER SEQUENCE categorias_cod_cat_seq OWNED BY categorias.cod_cat;

SELECT pg_catalog.setval('categorias_cod_cat_seq', 9, true);


CREATE TABLE convenio (
    cod_conv integer NOT NULL,
    nome_conv text
);

CREATE SEQUENCE convenio_cod_conv_seq
    INCREMENT BY 1
    NO MAXVALUE
    NO MINVALUE
    CACHE 1;

ALTER SEQUENCE convenio_cod_conv_seq OWNED BY convenio.cod_conv;

SELECT pg_catalog.setval('convenio_cod_conv_seq', 4, true);

CREATE TABLE equipamentos (
    cod_eq integer NOT NULL,
    cod_conv_eq integer,
    nome_eq character varying(50),
    descr_eq character varying(300),
    cod_cat_eq integer,
    patrimonio_eq integer
);

CREATE SEQUENCE equipamentos_cod_eq_seq
    INCREMENT BY 1
    NO MAXVALUE
    NO MINVALUE
    CACHE 1;


ALTER TABLE public.equipamentos_cod_eq_seq OWNER TO postgres;

ALTER SEQUENCE equipamentos_cod_eq_seq OWNED BY equipamentos.cod_eq;

SELECT pg_catalog.setval('equipamentos_cod_eq_seq', 62, true);

ALTER TABLE categorias ALTER COLUMN cod_cat SET DEFAULT nextval('categorias_cod_cat_seq'::regclass);

ALTER TABLE convenio ALTER COLUMN cod_conv SET DEFAULT nextval('convenio_cod_conv_seq'::regclass);

ALTER TABLE equipamentos ALTER COLUMN cod_eq SET DEFAULT nextval('equipamentos_cod_eq_seq'::regclass);

