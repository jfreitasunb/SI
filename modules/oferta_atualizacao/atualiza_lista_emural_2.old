<?PHP
include("head_oferta.php");


// Recebe o semestre e o ano:

$lista=$_REQUEST['lista'];
$periodo=explode("_",$lista);
$semestre=$periodo[0];
$ano=$periodo[1];

// carga_prof: nome | coduser | codigo | nivel | turma_disc | creditos_disc | creditos_prof | matriculas_na_turma | semestre | ano 
$query_dados_carga=pg_query("select name||' '||firstname as nome,c.* from oferta_carga_professor c,users u where c.coduser=u.coduser and semestre='".$semestre."' and ano='".$ano."' and nivel='GR' order by codigo,turma_disc,creditos_prof") or die("problema de conexa 1 em atualiza_lista_emural_2.php");

$query_dados_lista_de_ofertas=pg_query("select professor,disciplina,turma from oferta_lista_de_ofertas where semestre='".$semestre."' and ano='".$ano."' order by disciplina,turma") or die ("problema de conexa 2 em atualiza_lista_emural_2.php");
// Monta um array de alocacao de professor por discilpina/turma: 
$LO_prof=array();
while($registro_disc=pg_fetch_row($query_dados_lista_de_ofertas))
	{
	$LO_prof[$registro_disc[1]][$registro_disc[2]]=$registro_disc[0];
	}


$query_disciplinas=pg_query("select codigo,nome from disciplinas_mat where status='grad' order by codigo") or die("problema de conexa 3 em atualiza_lista_emural_2.php");
$Disciplinas=array();
while($registro_0=pg_fetch_row($query_disciplinas))
	{
	$Disciplinas[$registro_0[0]]=$registro_0[1];
	}

?>
<html>
  <header>
    <link type="text/css" rel="stylesheet" href="../../global/grafic.css">
<meta http-equiv="Content-Type" content="text/html;charset=UTF-8">
  </header>
  <body>
      <table class=big>
	<tr>
	<form method="POST" name="formu" action="atualiza_lista_emural_3.php">
        <td class=header align=center>
        <h1> Lista de Ofertas do <? echo $semestre;?>&ordm;/ <? echo $ano;?></h1>
        </td>
      </tr>
      <tr><td>
	<table border> 
	<tr><td><b>Disciplina</b></td><td><b>Turma</b></td><td><b>Professor</b></td><td><b>Cr&eacute;ditos</b></td><td><b>E-mural</b></td></tr>
	<tr></tr>
	<?
	$cor_de_fundo="#FFFFFF";
	$disc=0;
	while ($registro=pg_fetch_row($query_dados_carga))
		{
		if ($disc===0) $disc=$registro[2].$registro[4]; 
		if ($registro[2].$registro[4]!==$disc) 
			{
			$disc=$registro[2].$registro[4]; 
			if ($cor_de_fundo=="#FFFFFF") $cor_de_fundo="#D0D0D0"; else $cor_de_fundo="#FFFFFF";
			}
		?>
		<tr VALIGN=CENTER BGCOLOR="<? echo $cor_de_fundo;?>">
		<td><? echo $registro[2]."-".$Disciplinas[$registro[2]];?></td>
		<td><? echo $registro[4];?></td>
		<td><? echo $registro[0];?></td>
		<td><? echo $registro[6]/100;?></td>
		<?
		if($LO_prof[$registro[2]][$registro[4]]==$registro[1]) $checked="checked"; else $checked="";
		?>
			<td><input type=radio name='e_mural[<? echo $registro[2];?>][<? echo $registro[4];?>]' <? echo $checked;?> value="<? echo $registro[1];?>"></td>
		</tr>
		<?
		}
	?>
	</table> 
	<input type=hidden name='semestre' value="<? echo $semestre;?>">
	<input type=hidden name='ano' value="<? echo $ano;?>">
	<input type=submit name='confirma' value="Confirmar altera&ccedil;&otilde;es">
	</td>
	</form>
	</tr>
	</table>
	</body>
</html>
<?
pg_close($idconn);
?>

