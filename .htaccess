# Bloqueia acesso pela web a dumps de banco, logs/auxiliares do LaTeX,
# arquivos de infraestrutura e arquivos ocultos (.git, .htaccess, .env...).
<FilesMatch "(?i)(\.(sql|log|aux|bak|old|orig|swp|zip)|^Dockerfile|^docker-compose\.ya?ml|^banco_dado_admin)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F]
</IfModule>
